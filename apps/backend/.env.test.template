# Integration-test environment. Copy to `.env.test` (gitignored) and fill in
# DB_PASSWORD before running `npm run check`, which runs the test-DB suite.
# The runner spins up an ephemeral database on the server below; the Postgres
# port is the one published by compose.yaml. DB_PASSWORD must match the
# WORKWEAR_DB_PASSWORD generated by `npm run setup:env`.
#
# Safe to run locally only: these are local, non-production values.
NODE_ENV=test
DB_HOST=localhost
DB_USERNAME=werkfaden
DB_PASSWORD=
DB_PORT=5544
JWT_SECRET=change-me-test-only
COOKIE_SECRET=change-me-test-only
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
# Empty REDIS_URL uses the in-memory locking provider (fine for tests).
REDIS_URL=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Local mail sink (FR-11). The suite overrides this with a throwaway directory.
MAIL_SINK_DIR=mail-sink
MAIL_FROM=Werkfaden Demo <no-reply@werkfaden.test>
