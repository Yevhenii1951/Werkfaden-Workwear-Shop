{
  "name": "werkfaden-workwear-shop",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "setup:env": "node scripts/setup-local-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose stop",
    "db:migrate": "pnpm --filter @dtc/backend exec medusa db:migrate --skip-scripts --execute-safe-links --execute-safe-search",
    "typecheck": "pnpm --filter @dtc/backend exec tsc --noEmit && pnpm --filter @dtc/storefront exec tsc --noEmit",
    "check": "npx --yes pnpm@10.11.1 run lint && npx --yes pnpm@10.11.1 run typecheck && npx --yes pnpm@10.11.1 --filter @dtc/backend run test:unit && npx --yes pnpm@10.11.1 --filter @dtc/storefront run test:unit && npx --yes pnpm@10.11.1 --filter @dtc/backend run test:integration:http",
    "setup:store": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/setup-store.ts"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
